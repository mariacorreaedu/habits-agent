# Copie este arquivo para ".env" e preencha com seus dados do Supabase

# Project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=

# service_role key (Project Settings -> API -> Project API keys -> service_role)
# ATENÇÃO: essa chave tem acesso total ao banco. Nunca comite, nunca exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Porta onde o servidor MCP vai rodar
PORT=3001
